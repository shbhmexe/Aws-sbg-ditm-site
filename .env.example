# ============================================================
# AWS SBGL DITM — Environment Configuration
# ============================================================

# SMTP Email Configuration (e.g. Gmail App Password)
# 1. Enable 2-Step Verification in your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Name "AWS SBG Portfolio" and copy the 16-character code
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password

# Recipient Email for incoming contact messages
CONTACT_RECEIVER_EMAIL=your-gmail-address@gmail.com

SMTP_LOCAL_ADDRESS=
